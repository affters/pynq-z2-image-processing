proc connect_clock {clock_pin pins} {
    foreach pin $pins {
        connect_bd_net [get_bd_pins $clock_pin] [get_bd_pins $pin]
    }
}

proc copy_generated_files {folder output_dir} {
    foreach entry [glob -nocomplain -directory $folder *] {
        if {[file isdirectory $entry]} {
            copy_generated_files $entry $output_dir
        } elseif {[file tail $entry] in {ps7_init.tcl ps7_init.c ps7_init.h ps7_init.html image_system.hwh}} {
            file copy -force $entry [file join $output_dir [file tail $entry]]
        }
    }
}

set project_root [file normalize [file join [file dirname [info script]] ..]]
set output_dir [file join $project_root output image_system]
set project_dir [file join $project_root vivado_project]
set target_part xc7z020clg400-1
set_param general.maxThreads 2

if {[catch {
    if {![string match 2020.2* [version -short]]} {
        error "This build is pinned to Vivado 2020.2; found [version -short]"
    }
    file mkdir $output_dir
    create_project image_system $project_dir -part $target_part -force
    set_property target_language Verilog [current_project]
    set_property simulator_language Mixed [current_project]

    set rtl_sources [concat [glob -nocomplain [file join $project_root rtl *.v]] \
                            [glob -nocomplain [file join $project_root rtl *.sv]]]
    if {[llength $rtl_sources] == 0} {error "No RTL sources found"}
    add_files -norecurse $rtl_sources
    add_files -fileset constrs_1 -norecurse [file join $project_root constraints image_system.xdc]
    update_compile_order -fileset sources_1

    create_bd_design image_system
    set ps [create_bd_cell -type ip -vlnv xilinx.com:ip:processing_system7:5.5 processing_system7_0]
    apply_pynq_z2_ps7_preset $ps
    # Keep the upstream PYNQ-Z2 DDR/MIO settings. Change only PL-facing buses
    # and clocks needed by this design. No ZedBoard/ZC702 preset is used.
    set_property -dict [list \
        CONFIG.PCW_USE_M_AXI_GP0 {1} \
        CONFIG.PCW_USE_M_AXI_GP1 {0} \
        CONFIG.PCW_USE_S_AXI_HP0 {1} \
        CONFIG.PCW_S_AXI_HP0_DATA_WIDTH {64} \
        CONFIG.PCW_USE_FABRIC_INTERRUPT {0} \
        CONFIG.PCW_IRQ_F2P_INTR {0} \
        CONFIG.PCW_FPGA0_PERIPHERAL_FREQMHZ {50} \
        CONFIG.PCW_EN_CLK0_PORT {1} \
        CONFIG.PCW_EN_CLK1_PORT {0} \
        CONFIG.PCW_EN_CLK2_PORT {0} \
        CONFIG.PCW_EN_CLK3_PORT {0} \
        CONFIG.PCW_EN_RST0_PORT {1}] $ps

    create_bd_intf_port -mode Master -vlnv xilinx.com:interface:ddrx_rtl:1.0 DDR
    create_bd_intf_port -mode Master -vlnv xilinx.com:display_processing_system7:fixedio_rtl:1.0 FIXED_IO
    connect_bd_intf_net [get_bd_intf_ports DDR] [get_bd_intf_pins processing_system7_0/DDR]
    connect_bd_intf_net [get_bd_intf_ports FIXED_IO] [get_bd_intf_pins processing_system7_0/FIXED_IO]

    set dma [create_bd_cell -type ip -vlnv xilinx.com:ip:axi_dma:7.1 axi_dma_0]
    set_property -dict [list \
        CONFIG.c_include_sg {0} \
        CONFIG.c_include_mm2s {1} \
        CONFIG.c_include_s2mm {1} \
        CONFIG.c_include_mm2s_dre {0} \
        CONFIG.c_include_s2mm_dre {0} \
        CONFIG.c_m_axi_mm2s_data_width {32} \
        CONFIG.c_m_axi_s2mm_data_width {32} \
        CONFIG.c_m_axis_mm2s_tdata_width {32} \
        CONFIG.c_s_axis_s2mm_tdata_width {32} \
        CONFIG.c_mm2s_burst_size {16} \
        CONFIG.c_s2mm_burst_size {16} \
        CONFIG.c_addr_width {32} \
        CONFIG.c_sg_length_width {23}] $dma

    set gpio [create_bd_cell -type ip -vlnv xilinx.com:ip:axi_gpio:2.0 axi_gpio_0]
    set_property -dict [list \
        CONFIG.C_IS_DUAL {1} \
        CONFIG.C_GPIO_WIDTH {32} \
        CONFIG.C_GPIO2_WIDTH {32} \
        CONFIG.C_ALL_INPUTS {0} \
        CONFIG.C_ALL_OUTPUTS {1} \
        CONFIG.C_ALL_INPUTS_2 {1} \
        CONFIG.C_ALL_OUTPUTS_2 {0} \
        CONFIG.C_INTERRUPT_PRESENT {0} \
        CONFIG.C_DOUT_DEFAULT {0x00000000}] $gpio

    set control_ic [create_bd_cell -type ip -vlnv xilinx.com:ip:axi_interconnect:2.1 axi_control_interconnect]
    set_property -dict [list CONFIG.NUM_SI {1} CONFIG.NUM_MI {2}] $control_ic
    set memory_ic [create_bd_cell -type ip -vlnv xilinx.com:ip:axi_interconnect:2.1 axi_memory_interconnect]
    set_property -dict [list CONFIG.NUM_SI {2} CONFIG.NUM_MI {1}] $memory_ic

    create_bd_cell -type module -reference image_axis_core image_axis_core_0
    set_property -dict [list CONFIG.IMAGE_WIDTH {128} CONFIG.IMAGE_HEIGHT {96}] [get_bd_cells image_axis_core_0]
    connect_bd_intf_net [get_bd_intf_pins axi_dma_0/M_AXIS_MM2S] [get_bd_intf_pins image_axis_core_0/S_AXIS]
    connect_bd_intf_net [get_bd_intf_pins image_axis_core_0/M_AXIS] [get_bd_intf_pins axi_dma_0/S_AXIS_S2MM]
    connect_bd_net [get_bd_pins axi_gpio_0/gpio_io_o] [get_bd_pins image_axis_core_0/control]
    connect_bd_net [get_bd_pins image_axis_core_0/status] [get_bd_pins axi_gpio_0/gpio2_io_i]

    connect_bd_intf_net [get_bd_intf_pins processing_system7_0/M_AXI_GP0] [get_bd_intf_pins axi_control_interconnect/S00_AXI]
    connect_bd_intf_net [get_bd_intf_pins axi_control_interconnect/M00_AXI] [get_bd_intf_pins axi_dma_0/S_AXI_LITE]
    connect_bd_intf_net [get_bd_intf_pins axi_control_interconnect/M01_AXI] [get_bd_intf_pins axi_gpio_0/S_AXI]
    connect_bd_intf_net [get_bd_intf_pins axi_dma_0/M_AXI_MM2S] [get_bd_intf_pins axi_memory_interconnect/S00_AXI]
    connect_bd_intf_net [get_bd_intf_pins axi_dma_0/M_AXI_S2MM] [get_bd_intf_pins axi_memory_interconnect/S01_AXI]
    connect_bd_intf_net [get_bd_intf_pins axi_memory_interconnect/M00_AXI] [get_bd_intf_pins processing_system7_0/S_AXI_HP0]

    set reset [create_bd_cell -type ip -vlnv xilinx.com:ip:proc_sys_reset:5.0 rst_fclk0]
    # C_EXT_RESET_HIGH is read-only in IP Integrator. Its value is propagated
    # from the active-low PS7 FCLK_RESET0_N interface connected below.
    # AUX is user-overridable (proc_sys_reset_v5_0/bd/bd.tcl). It is tied to
    # zero below, so explicitly make it active-high rather than allowing a
    # propagated active-low polarity to hold every AXI peripheral in reset.
    set_property CONFIG.C_AUX_RESET_HIGH {1} $reset
    set one [create_bd_cell -type ip -vlnv xilinx.com:ip:xlconstant:1.1 constant_one]
    set_property -dict [list CONFIG.CONST_WIDTH {1} CONFIG.CONST_VAL {1}] $one
    set zero [create_bd_cell -type ip -vlnv xilinx.com:ip:xlconstant:1.1 constant_zero]
    set_property -dict [list CONFIG.CONST_WIDTH {1} CONFIG.CONST_VAL {0}] $zero
    connect_bd_net [get_bd_pins processing_system7_0/FCLK_RESET0_N] [get_bd_pins rst_fclk0/ext_reset_in]
    connect_bd_net [get_bd_pins constant_one/dout] [get_bd_pins rst_fclk0/dcm_locked]
    connect_bd_net [get_bd_pins constant_zero/dout] [get_bd_pins rst_fclk0/aux_reset_in] [get_bd_pins rst_fclk0/mb_debug_sys_rst]

    connect_clock processing_system7_0/FCLK_CLK0 {
        processing_system7_0/M_AXI_GP0_ACLK processing_system7_0/S_AXI_HP0_ACLK
        axi_dma_0/s_axi_lite_aclk axi_dma_0/m_axi_mm2s_aclk axi_dma_0/m_axi_s2mm_aclk
        axi_gpio_0/s_axi_aclk image_axis_core_0/clk rst_fclk0/slowest_sync_clk
        axi_control_interconnect/ACLK axi_control_interconnect/S00_ACLK
        axi_control_interconnect/M00_ACLK axi_control_interconnect/M01_ACLK
        axi_memory_interconnect/ACLK axi_memory_interconnect/S00_ACLK
        axi_memory_interconnect/S01_ACLK axi_memory_interconnect/M00_ACLK
    }
    foreach cell {axi_control_interconnect axi_memory_interconnect} {
        foreach pin [get_bd_pins -of_objects [get_bd_cells $cell] -filter {TYPE == rst && DIR == I}] {
            connect_bd_net [get_bd_pins rst_fclk0/interconnect_aresetn] $pin
        }
    }
    connect_bd_net [get_bd_pins rst_fclk0/peripheral_aresetn] \
        [get_bd_pins axi_dma_0/axi_resetn] [get_bd_pins axi_gpio_0/s_axi_aresetn] [get_bd_pins image_axis_core_0/resetn]

    assign_bd_address -offset 0x40400000 -range 0x00010000 \
        -target_address_space [get_bd_addr_spaces processing_system7_0/Data] \
        [get_bd_addr_segs axi_dma_0/S_AXI_LITE/Reg] -force
    assign_bd_address -offset 0x41200000 -range 0x00010000 \
        -target_address_space [get_bd_addr_spaces processing_system7_0/Data] \
        [get_bd_addr_segs axi_gpio_0/S_AXI/Reg] -force
    foreach dma_space {Data_MM2S Data_S2MM} {
        assign_bd_address -offset 0x00000000 -range 0x20000000 \
            -target_address_space [get_bd_addr_spaces axi_dma_0/$dma_space] \
            [get_bd_addr_segs processing_system7_0/S_AXI_HP0/HP0_DDR_LOWOCM] -force
    }

    validate_bd_design -force
    set ext_reset_high [get_property CONFIG.C_EXT_RESET_HIGH $reset]
    set aux_reset_high [get_property CONFIG.C_AUX_RESET_HIGH $reset]
    if {$ext_reset_high ne "0" || $aux_reset_high ne "1"} {
        error "Reset polarity mismatch after validation: EXT=$ext_reset_high AUX=$aux_reset_high (expected EXT=0 AUX=1)"
    }
    save_bd_design
    write_bd_tcl -force [file join $output_dir image_system_bd.tcl]
    set bd_file [get_files image_system.bd]
    generate_target all $bd_file
    export_ip_user_files -of_objects $bd_file -no_script -sync -force -quiet
    # Export generated board-specific initialization/HWH before implementation.
    copy_generated_files $project_dir $output_dir
    set hwh_handle [open [file join $output_dir image_system.hwh] r]
    set hwh_text [read $hwh_handle]
    close $hwh_handle
    if {![regexp {(?s)<MODULE[^>]*INSTANCE="rst_fclk0"[^>]*>(.*?)</MODULE>} $hwh_text unused reset_hwh]} {
        error "Generated HWH is missing rst_fclk0"
    }
    foreach {parameter expected} {C_EXT_RESET_HIGH 0 C_AUX_RESET_HIGH 1} {
        set pattern [format {<PARAMETER[^>]*NAME="%s"[^>]*VALUE="%s"[^>]*/>} $parameter $expected]
        if {![regexp $pattern $reset_hwh]} {
            error "Generated HWH reset polarity mismatch: $parameter must be $expected"
        }
    }
    puts "IMAGE_SYSTEM_RESET_POLARITY_OK ext_active_high=0 aux_active_high=1 aux_tied_low=1"
    puts "IMAGE_SYSTEM_BD_OK clock_hz=50000000 gpio=0x41200000 dma=0x40400000"

    set wrappers [make_wrapper -files $bd_file -top]
    add_files -norecurse $wrappers
    set_property top image_system_wrapper [current_fileset]
    set_property synth_checkpoint_mode None $bd_file
    update_compile_order -fileset sources_1
    launch_runs synth_1 -jobs 2
    wait_on_run synth_1
    if {[get_property PROGRESS [get_runs synth_1]] ne "100%"} {
        error "Synthesis failed: [get_property STATUS [get_runs synth_1]]"
    }
    launch_runs impl_1 -to_step write_bitstream -jobs 2
    wait_on_run impl_1
    if {[get_property PROGRESS [get_runs impl_1]] ne "100%"} {
        error "Implementation failed: [get_property STATUS [get_runs impl_1]]"
    }
    open_run impl_1
    report_utilization -file [file join $output_dir utilization.rpt]
    report_timing_summary -delay_type min_max -max_paths 10 -report_unconstrained -file [file join $output_dir timing_summary.rpt]
    report_clock_utilization -file [file join $output_dir clock_utilization.rpt]
    report_route_status -file [file join $output_dir route_status.rpt]
    report_drc -file [file join $output_dir drc.rpt]
    check_timing -verbose -file [file join $output_dir check_timing.rpt]
    set drc_errors [get_drc_violations -filter {SEVERITY == Error}]
    if {[llength $drc_errors] != 0} {error "Implementation DRC errors: $drc_errors"}
    set fabric_clocks [get_clocks -quiet -filter {PERIOD > 19.999 && PERIOD < 20.001}]
    if {[llength $fabric_clocks] == 0} {error "No implemented 50 MHz fabric clock was found"}
    set setup_paths [get_timing_paths -delay_type max -max_paths 1]
    set hold_paths [get_timing_paths -delay_type min -max_paths 1]
    if {[llength $setup_paths] == 0 || [llength $hold_paths] == 0} {error "No timing paths were analyzed"}
    set setup_slack [get_property SLACK [lindex $setup_paths 0]]
    set hold_slack [get_property SLACK [lindex $hold_paths 0]]
    if {$setup_slack < 0 || $hold_slack < 0} {error "Timing failed: setup=$setup_slack hold=$hold_slack"}
    write_checkpoint -force [file join $output_dir image_system_routed.dcp]
    write_hw_platform -fixed -include_bit -force -file [file join $output_dir image_system.xsa]
    file copy -force [file join $project_dir image_system.runs impl_1 image_system_wrapper.bit] [file join $output_dir image_system.bit]
    copy_generated_files $project_dir $output_dir
    foreach required {image_system.bit image_system.hwh image_system.xsa ps7_init.tcl} {
        if {![file exists [file join $output_dir $required]]} {error "Missing required artifact: $required"}
    }
    set info [open [file join $output_dir implementation_summary.txt] w]
    puts $info "status=IMPLEMENTED_NOT_PROGRAMMED"
    puts $info "part=$target_part"
    puts $info "fabric_clock_hz=50000000"
    puts $info "setup_slack_ns=$setup_slack"
    puts $info "hold_slack_ns=$hold_slack"
    puts $info "drc_errors=[llength $drc_errors]"
    puts $info "ext_reset_active_high=$ext_reset_high"
    puts $info "aux_reset_active_high=$aux_reset_high aux_tied_low=1"
    puts $info "image_width=128"
    puts $info "image_height=96"
    puts $info "gpio_address=0x41200000 control_offset=0x00 status_offset=0x08"
    puts $info "dma_address=0x40400000 mode=simple stream_bits=32 memory_bits=32 length_bits=23"
    puts $info "ps7_preset=Xilinx/PYNQ@v2.7.0:dd415eac9a19aeb5ec9341718c47a68f76204544"
    close $info
    puts "IMAGE_SYSTEM_BUILD_OK setup_slack_ns=$setup_slack hold_slack_ns=$hold_slack programmed=0"
    close_project
} failure]} {
    puts stderr "IMAGE_SYSTEM_BUILD_FAILED: $failure"
    puts stderr $::errorInfo
    catch {close_project}
    exit 1
}
exit 0
