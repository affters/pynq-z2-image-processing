# DDR and FIXED_IO belong to the Zynq PS7 dedicated pins; their constraints
# are generated by the matching PYNQ-Z2 processing_system7 IP preset.
# FCLK0 is generated inside PS7 at 50 MHz and its 20 ns timing constraint
# is generated with the IP. There is no external PL clock or PL package I/O.
# The build checks the implemented 20 ns clock and setup/hold slack.
set_property BITSTREAM.GENERAL.COMPRESS TRUE [current_design]
